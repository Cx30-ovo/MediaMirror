# Copy to .env. Secrets are read only by the local server; do not use a VITE_ prefix.
DATA_API_BASE_URL=http://192.168.3.162:8787
# Default: load ALL records returned by the current source, in bounded pages.
DATA_SCOPE=all
DATA_PAGE_SIZE=200
DATA_LOAD_DETAILS=true
DATA_DETAIL_CONCURRENCY=4
# Used only when DATA_SCOPE=latest; does not limit the default all-data mode.
DATA_LIMIT_PER_PLATFORM=10
# Current collector is read-only and requires no authentication.
DATA_API_KEY=
DATA_AUTH_HEADER=Authorization
DATA_AUTH_PREFIX="Bearer "
# Leave empty until these endpoints exist. See docs/LIVE-INTEGRATION.md for their schema.
DATA_COMMENTS_PATH=
DATA_HOTSPOTS_PATH=

# OpenAI-compatible Chat Completions. Include /v1 if required by your provider.
# Example: https://api.deepseek.com/v1 or https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_JSON_MODE=false
# Some services require max_completion_tokens instead of max_tokens.
MODEL_TOKEN_FIELD=max_tokens
MODEL_MAX_TOKENS=6000
REQUEST_TIMEOUT_SECONDS=90
# Start with a single test. Set true after reviewing results to allow timed model calls.
MODEL_AUTO_ANALYZE=false
# 0 表示不限每小时调用次数；正整数可重新启用本地限额。
MODEL_MAX_CALLS_PER_HOUR=0

# Future persistence: MongoDB only. These reserved settings are not used by this prototype yet.
MONGODB_URI=
MONGODB_DATABASE=mediamirror

# Optional, only for Qwen/vLLM chat-template services. Leave blank for other providers.
MODEL_CHAT_TEMPLATE_ENABLE_THINKING=
